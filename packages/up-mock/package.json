{
  "name": "up-bank-mock",
  "version": "0.1.0",
  "private": true,
  "description": "A deterministic, offline mock of the Up (up.com.au) read-only API and webhooks, for development and automated tests. Not affiliated with Up.",
  "license": "MIT",
  "keywords": ["up", "up-bank", "mock", "webhooks", "testing"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "docs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test dist/mock.test.js",
    "start": "npm run build && node dist/cli.js"
  },
  "bin": {
    "up-bank-mock": "./dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
